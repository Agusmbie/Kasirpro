{
  "name": "kasir-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi POS (Kasir & Manajemen Stok) berdasarkan kasir-prd.md",
  "scripts": {
    "setup:db": "cd server && npm run setup:db",
